{
  "name": "coat-electron",
  "version": "0.1.0",
  "private": true,
  "description": "coat — the wallpaper lane, as a hidden-console Windows tray app (Electron shell)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "postinstall": "electron-builder install-app-deps"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "io.toxicwind.coat",
    "productName": "coat",
    "files": ["main.js"],
    "extraResources": [
      { "from": "../src", "to": "daemon/src" },
      { "from": "../package.json", "to": "daemon/package.json" },
      { "from": "../bun.lock", "to": "daemon/bun.lock", "filter": ["*"] },
      { "from": "icon.png", "to": "icon.png" }
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico",
      "artifactName": "coat-setup.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "runAfterFinish": true,
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico"
    }
  }
}